  "stories": {
    "cooking_001": {
      "story_id": "cooking_001",
      "voice": "ja-JP-NanamiNeural",
      "source_sha256": "5a6eb9d711aa134879ac7993904d1b52777c50733184c96bfce5a351d9ac4892",
      "paragraphs": [
        {
          "id": "p1",
          "sentences": [
            {
              "id": "s1",
              "text": "土曜日の夕方、友達と家でカレーを作ることになりました。"
            },
            {
              "id": "s2",
              "text": "買い物に行く前に、冷蔵庫の中の材料を確認しました。"
            },
            {
              "id": "s3",
              "text": "玉ねぎと肉はありましたが、じゃがいもが足りませんでした。"
            },
            {
              "id": "s4",
              "text": "私は必要な材料を紙に書いて、近くの店へ行きました。"
            }
          ]
        },
        {
          "id": "p2",
          "sentences": [
            {
              "id": "s5",
              "text": "ところが、店でもじゃがいもは売り切れていました。"
            },
            {
              "id": "s6",
              "text": "別の店は遠いので、友達に電話して相談しました。"
            },
            {
              "id": "s7",
              "text": "友達は「代わりに、かぼちゃを使ってみよう」と言いました。"
            },
            {
              "id": "s8",
              "text": "いつもと違う味になりそうで、少し楽しみになりました。"
            }
          ]
        },
        {
          "id": "p3",
          "sentences": [
            {
              "id": "s9",
              "text": "家に戻って、二人で野菜を小さく切りました。"
            },
            {
              "id": "s10",
              "text": "友達が野菜を炒めている間に、私はご飯を炊きました。"
            },
            {
              "id": "s11",
              "text": "音楽を聞きながら作ったので、待つ時間も楽しかったです。"
            },
            {
              "id": "s12",
              "text": "最後に味を見て、塩を少しだけ足しました。"
            }
          ]
        },
        {
          "id": "p4",
          "sentences": [
            {
              "id": "s13",
              "text": "かぼちゃの甘さで、カレーはやさしい味になりました。"
            },
            {
              "id": "s14",
              "text": "材料が足りないときも、相談すると新しい考えが見つかります。"
            },
            {
              "id": "s15",
              "text": "次は別の野菜でも作ってみたいです。"
            }
          ]
        }
      ],
