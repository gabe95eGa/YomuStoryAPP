{
  "name": "yomustory-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "sync-content": "node scripts/sync-content.mjs",
    "sync-assets": "pnpm sync-content && node scripts/sync-dictionary-notice.mjs",
    "dev": "pnpm sync-assets && vite --config reader/vite.config.ts",
    "typecheck": "tsc --noEmit -p reader/tsconfig.json",
    "test": "vitest run --config reader/vite.config.ts",
    "build": "pnpm sync-assets && pnpm typecheck && vite build --config reader/vite.config.ts",
    "preview": "vite preview --config reader/vite.config.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
